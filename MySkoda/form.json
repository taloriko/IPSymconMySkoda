{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "Connection and vehicle",
      "expanded": true,
      "items": [
        {
          "type": "Label",
          "caption": "MySkoda vehicle data is read directly from the official MySkoda Public API."
        },
        {
          "type": "Label",
          "caption": "Create the API key in the MySkoda app: Profile -> Smart Home -> Create Key -> enter any name -> copy VIN and API token into this module."
        },
        {
          "type": "ValidationTextBox",
          "name": "VIN",
          "caption": "VIN",
          "validate": "^[A-HJ-NPR-Z0-9]{17}$"
        },
        {
          "type": "PasswordTextBox",
          "name": "APIToken",
          "caption": "API token"
        },
        {
          "type": "Label",
          "name": "ConnectionFeedback",
          "caption": "Connection has not been tested yet.",
          "bold": true
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Visualization settings",
      "expanded": true,
      "items": [
        {
          "type": "Select",
          "name": "VehicleDesign",
          "caption": "Vehicle design",
          "options": [
            {"caption": "Automatic", "value": "auto"},
            {"caption": "Enyaq", "value": "enyaq"},
            {"caption": "Elroq", "value": "elroq"},
            {"caption": "Epiq", "value": "epiq"},
            {"caption": "Generic", "value": "generic"}
          ]
        },
        {
          "type": "Label",
          "caption": "Automatic selection uses model information returned by MySkoda. If the model cannot be determined reliably, choose it manually."
        },
        {
          "type": "CheckBox",
          "name": "HideVisualizationTitle",
          "caption": "Hide Symcon tile title"
        },
        {
          "type": "Label",
          "name": "TileTitleSupportFeedback",
          "caption": "The Symcon tile title can be hidden while the instance name remains unchanged in the object tree."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Polling and control",
      "expanded": true,
      "items": [
        {
          "type": "NumberSpinner",
          "name": "Interval",
          "caption": "Polling interval",
          "suffix": " seconds",
          "minimum": 180,
          "maximum": 3600
        },
        {
          "type": "Label",
          "caption": "Recommended: 300 seconds. The module observes the rate-limit headers returned by the API."
        },
        {
          "type": "CheckBox",
          "name": "EnableRemote",
          "caption": "Enable remote control"
        },
        {
          "type": "CheckBox",
          "name": "ClimateWithoutExternalPower",
          "caption": "Allow air conditioning without external power"
        },
        {
          "type": "PasswordTextBox",
          "name": "SPIN",
          "caption": "S-PIN (optional, auxiliary heating only)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Notifications",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "NotifyKeyExpiry",
          "caption": "Send a Symcon notification when the API key has 30 days or less remaining"
        },
        {
          "type": "SelectInstance",
          "name": "NotificationInstanceID",
          "caption": "Visualization for notifications",
          "validModules": []
        },
        {
          "type": "Label",
          "name": "NotificationTargetFeedback",
          "caption": "Select a Tile Visualization or WebFront for notifications."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Advanced",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "ShowDetails",
          "caption": "Show detail and diagnostic variables"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Help and documentation",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Module and documentation: https://github.com/taloriko/IPSymconMySkoda",
          "link": true
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "Button",
          "caption": "Test connection",
          "onClick": "echo MSKODA_TestConnection($id) ? 'Connection successful - vehicle data received.' : 'Connection failed - check instance status and API data.';"
        },
        {
          "type": "Button",
          "caption": "Update now",
          "onClick": "MSKODA_Update($id); echo 'Update executed';"
        }
      ]
    },
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "Button",
          "caption": "Test notification",
          "onClick": "echo MSKODA_TestNotification($id) ? 'Notification sent.' : 'Notification could not be sent. Check the selected visualization and registered mobile devices.';"
        },
        {
          "type": "Button",
          "caption": "Reload API definition",
          "onClick": "echo MSKODA_RefreshApiDefinition($id) ? 'API definition updated' : 'API definition could not be loaded';"
        }
      ]
    }
  ],
  "status": [
    {"code": 102, "icon": "active", "caption": "Connected to MySkoda"},
    {"code": 104, "icon": "inactive", "caption": "Inactive"},
    {"code": 201, "icon": "error", "caption": "VIN or API token is missing or invalid"},
    {"code": 202, "icon": "error", "caption": "Connection to MySkoda failed / API error"},
    {"code": 203, "icon": "warning", "caption": "Rate limit / waiting period active"}
  ]
}
