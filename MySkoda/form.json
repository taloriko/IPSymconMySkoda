{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "Verbindung",
      "expanded": true,
      "items": [
        {
          "type": "Label",
          "caption": "Die Fahrzeugdaten werden direkt über die offizielle MySkoda Public API gelesen."
        },
        {
          "type": "Label",
          "caption": "API-Key in der MySkoda App erstellen: Profil -> Smart Home -> Schlüssel erstellen. Anschließend FIN und API-Token hier eintragen."
        },
        {
          "type": "ValidationTextBox",
          "name": "VIN",
          "caption": "FIN / VIN",
          "validate": "^[A-HJ-NPR-Z0-9]{17}$"
        },
        {
          "type": "PasswordTextBox",
          "name": "APIToken",
          "caption": "API-Token"
        },
        {
          "type": "Label",
          "name": "ConnectionFeedback",
          "caption": "Verbindung wurde noch nicht geprüft.",
          "bold": true
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Abfrage und Steuerung",
      "expanded": true,
      "items": [
        {
          "type": "NumberSpinner",
          "name": "Interval",
          "caption": "Abfrageintervall",
          "suffix": " Sekunden",
          "minimum": 180,
          "maximum": 3600
        },
        {
          "type": "Label",
          "caption": "Empfehlung: 300 Sekunden. Das Modul berücksichtigt die Rate-Limit-Angaben der API."
        },
        {
          "type": "CheckBox",
          "name": "EnableRemote",
          "caption": "Remote-Steuerung aktivieren"
        },
        {
          "type": "CheckBox",
          "name": "ClimateWithoutExternalPower",
          "caption": "Klimatisierung ohne externe Stromversorgung erlauben"
        },
        {
          "type": "PasswordTextBox",
          "name": "SPIN",
          "caption": "S-PIN (optional, nur Standheizung)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Mitteilungen",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "NotifyKeyExpiry",
          "caption": "Symcon-Mitteilung senden, wenn der API-Key höchstens noch 30 Tage gültig ist"
        },
        {
          "type": "SelectInstance",
          "name": "NotificationInstanceID",
          "caption": "Visualisierung für Mitteilungen",
          "validModules": []
        },
        {
          "type": "Label",
          "name": "NotificationTargetFeedback",
          "caption": "Tile Visualization oder WebFront für Mitteilungen auswählen."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Zusätzliche Daten",
      "expanded": false,
      "items": [
        {
          "type": "CheckBox",
          "name": "ShowDetails",
          "caption": "Detail- und Diagnosevariablen anlegen"
        },
        {
          "type": "Label",
          "caption": "Fehlende Detailvariablen werden bei Aktivierung angelegt. Bereits vorhandene Variablen bleiben beim Deaktivieren erhalten."
        },
        {
          "type": "CheckBox",
          "name": "EnableChargingHistory",
          "caption": "Archivierung aktivieren"
        },
        {
          "type": "Label",
          "caption": "Archiviert Ladezustand, Ladelimit, Ladeleistung und Kilometerstand. Der Kilometerstand wird als Zähler geführt; Werte kleiner oder gleich 0 werden verworfen."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Hilfe und Dokumentation",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Dokumentation und Quellcode: github.com/taloriko/IPSymconMySkoda"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "Button",
          "caption": "Verbindung testen",
          "onClick": "echo MSKODA_TestConnection($id) ? 'Verbindung erfolgreich - Fahrzeugdaten empfangen.' : 'Verbindung fehlgeschlagen - Instanzstatus und API-Daten prüfen.';"
        },
        {
          "type": "Button",
          "caption": "Jetzt aktualisieren",
          "onClick": "MSKODA_Update($id); echo 'Aktualisierung ausgeführt';"
        }
      ]
    },
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "Button",
          "caption": "Mitteilung testen",
          "onClick": "echo MSKODA_TestNotification($id) ? 'Mitteilung gesendet.' : 'Mitteilung konnte nicht gesendet werden. Ausgewählte Visualisierung und registrierte Mobilgeräte prüfen.';"
        },
        {
          "type": "Button",
          "caption": "API-Definition neu laden",
          "onClick": "echo MSKODA_RefreshApiDefinition($id) ? 'API-Definition aktualisiert' : 'API-Definition konnte nicht geladen werden';"
        }
      ]
    }
  ],
  "status": [
    {"code": 102, "icon": "active", "caption": "Mit MySkoda verbunden"},
    {"code": 104, "icon": "inactive", "caption": "Inaktiv"},
    {"code": 201, "icon": "error", "caption": "FIN oder API-Token fehlt oder ist ungültig"},
    {"code": 202, "icon": "error", "caption": "Verbindung zu MySkoda fehlgeschlagen / API-Fehler"},
    {"code": 203, "icon": "warning", "caption": "Rate-Limit / Wartezeit aktiv"}
  ]
}
